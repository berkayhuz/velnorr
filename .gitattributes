# Normalize source files across contributors and CI.
* text=auto eol=lf

# Source and configuration files
*.swift text diff=swift
*.sh text eol=lf
*.strings text eol=lf
*.plist text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary artwork and distribution files
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.dmg binary

